# Netlify runtime variables for the private ACE staff connector.
# Never commit real values.
ACE_CONNECTOR_MODE=disabled
ACE_USERNAME=
ACE_PASSWORD=
ACE_LOOKUP_TOKEN=

# Dedicated 32+ byte random secret for catalog and freight selection signatures.
# Rotate independently of the supplier password.
REMAN_SIGNING_SECRET=
OFFICE_ORDER_INGEST_URL=
OFFICE_FREIGHT_INGEST_URL=
OFFICE_PROMOTION_RESERVE_URL=
OFFICE_INTERNAL_INGEST_SECRET=

# Integrity retail pricing: current wholesale package cost plus this flat margin.
REMAN_MARKUP_FLAT=500
REMAN_QUOTE_EXPIRY_DAYS=7

# Public VIN lookup. The response is allowlisted and never includes wholesale cost.
ACE_PUBLIC_LOOKUP_ENABLED=true

# Customer checkout. Keep disabled until the restricted Stripe key and webhook
# signing secret are both configured in Netlify.
REMAN_CHECKOUT_ENABLED=false
STRIPE_RESTRICTED_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Tax product categories confirmed for this retail workflow.
STRIPE_TRANSMISSION_TAX_CODE=txcd_99999999
STRIPE_CORE_TAX_CODE=txcd_99999999
STRIPE_FREIGHT_TAX_CODE=txcd_92010001
