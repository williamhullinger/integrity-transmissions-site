# Netlify runtime variables for the private ACE staff connector.
# Never commit real values.
ACE_CONNECTOR_MODE=disabled
ACE_USERNAME=
ACE_PASSWORD=
ACE_LOOKUP_TOKEN=

# Integrity retail-pricing defaults. The larger of ACE suggested retail,
# the percentage markup, or the minimum gross-margin floor is used.
REMAN_MARKUP_PERCENT=35
REMAN_MIN_MARGIN=1000
REMAN_PRICE_ROUND_TO=25
REMAN_QUOTE_EXPIRY_DAYS=7
