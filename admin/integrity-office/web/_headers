/*
  Cache-Control: no-store, max-age=0
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-Permitted-Cross-Domain-Policies: none
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), geolocation=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; frame-src https://*.auth0.com; form-action 'self' https://*.auth0.com; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://*.auth0.com; worker-src 'self' blob:; upgrade-insecure-requests
  X-Robots-Tag: noindex, nofollow, noarchive

/assets/*
  Cache-Control: private, max-age=3600, must-revalidate

/api/*
  Cache-Control: no-store, max-age=0
  X-Robots-Tag: noindex, nofollow, noarchive

/.netlify/functions/*
  Cache-Control: no-store, max-age=0
  X-Robots-Tag: noindex, nofollow, noarchive
