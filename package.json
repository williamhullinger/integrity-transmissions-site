{
  "name": "integrity-transmissions-site",
  "version": "1.0.0",
  "private": true,
  "description": "Netlify functions for Integrity Transmission & Drivetrain",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "node scripts/build-integrity-site.mjs",
    "audit": "node projects/hullinger-transmission/scripts/audit-production.mjs",
    "test": "npm run audit && npm run test:ace && npm run test:checkout && npm run test:office && npm run test:seo && npm run test:build && npm run test:routes",
    "test:syntax": "node projects/hullinger-transmission/scripts/audit-production.mjs --syntax-only",
    "test:ace": "node projects/hullinger-transmission/scripts/test-ace-integration.mjs",
    "test:checkout": "node projects/hullinger-transmission/scripts/test-reman-checkout.mjs",
    "test:office": "node admin/integrity-office/test/order-state.test.mjs",
    "test:seo": "node projects/hullinger-transmission/scripts/audit-seo.mjs",
    "test:build": "node scripts/test-integrity-build.mjs",
    "test:routes": "INTEGRITY_SITE_ROOT=dist/integrity node projects/hullinger-transmission/scripts/test-production-routes.mjs"
  },
  "dependencies": {
    "stripe": "22.6.1"
  }
}
